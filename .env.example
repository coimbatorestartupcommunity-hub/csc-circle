CSC_KV_REST_API_TOKEN=
CSC_REDIS_ENABLED=false
CSC_REDIS_CACHE=false
CSC_REDIS_RATE_LIMIT=false
# Optional diagnostics label (REST URLs carry no region) and namespace override.
CSC_REDIS_REGION=
CSC_REDIS_ENV=

# WhatsApp Official Cloud API & Automated Notification Worker
